# Optional one-company Nexera ERP integration. Never commit a real token.
CRM_ERP_URL=
CRM_ERP_TOKEN=
# Enable only after existing balances are reconciled and Accounting mappings are confirmed.
CRM_ERP_SYNC_ENABLED=false
CRM_ENV=development
CRM_DATABASE_URL=sqlite:///./crm.db
CRM_UPLOAD_DIR=./data/uploads
# Set the exact external origin when using a reverse proxy or browser preview.
CRM_PUBLIC_ORIGIN=
CRM_ADMIN_EMAIL=admin@crm.local
# Set a strong password for a new non-demo workspace.
CRM_ADMIN_PASSWORD=

# Hosted SaaS mode (one database per client workspace). Keep "single" in production for this release.
CRM_TENANCY=single
# Hosted only: control-plane PostgreSQL, base domain (workspaces at https://<slug>.<domain>) and limits.
CRM_CONTROL_DATABASE_URL=
CRM_WORKSPACE_DATABASE_URL=
CRM_BASE_DOMAIN=
CRM_MAX_OPEN_WORKSPACES=50
# Hosted only, server secret store: at least 32 characters; set _PREVIOUS while rotating.
CRM_SECRET_KEY=
CRM_SECRET_KEY_PREVIOUS=
# Provider surface (separate host), SHA-256 hex of the provider bearer key, never the key itself.
CRM_PROVIDER_HOST=
CRM_PROVIDER_API_KEY_SHA256=
# Provisioner/CLI only, never the web process.
CRM_PROVISIONER_DATABASE_URL=
CRM_ERP_PLATFORM_KEY=
# Automatic ERP posting worker (python -m app.accounting_worker). Refuses to run when CRM_ENV=production.
CRM_ACCOUNTING_WORKER_ENABLED=false
